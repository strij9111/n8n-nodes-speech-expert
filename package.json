{
	"name": "n8n-nodes-speech-expert",
	"version": "0.1.0",
	"description": "Speech Expert nodes for transcription, speech synthesis, audio research, and synthesis comparison",
	"license": "MIT",
	"homepage": "https://github.com/strij9111/n8n-nodes-speech-expert#readme",
	"keywords": [
		"n8n-community-node-package",
		"speech",
		"transcription",
		"tts",
		"audio"
	],
	"author": {
		"name": "Sergey Komarov",
		"email": "skomarov@speech-expert.ru"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/strij9111/n8n-nodes-speech-expert.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test tests/*.test.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "npm run lint && npm test"
	},
	"files": [
		"dist/nodes",
		"dist/credentials",
		"examples",
		"docs"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SpeechExpertApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SpeechExpert/SpeechExpert.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.6",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
